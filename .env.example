# Aura Production-Grade Authentication Environment Configuration

# Server
PORT=8080
NODE_ENV=development

# JWT Secret (generate a 64+ char random string in production)
AURA_JWT_SECRET=aura-jwt-super-secret-key-production-grade-2026

# Token Lifetimes
# ACCESS_TOKEN_EXPIRY=15m
# REFRESH_TOKEN_EXPIRY_DAYS=30
# EMAIL_VERIFY_EXPIRY_HOURS=24
# PASSWORD_RESET_EXPIRY_MINUTES=30

# Rate Limiting
# LOGIN_RATE_LIMIT=5
# FORGOT_PASSWORD_RATE_LIMIT=3

# Optional Third-Party Services
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

